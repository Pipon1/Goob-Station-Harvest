# addaction
cmd-addaction-desc = Ajoute une action à l'entité cible. L'action ne fonctionnera pas si la cible nécessite un composant supplémentaire sur son entité (comme la Dévoration du Dragon).
cmd-addaction-help = addaction <EntityUid> <ActionPrototype>

cmd-addaction-invalid-args = Exactement 2 arguments attendus.
cmd-addaction-actions-not-found = L'entité cible ne peut pas utiliser d'actions.
cmd-addaction-action-not-found = Impossible de trouver le prototype d'action correspondant {$action}.
cmd-addaction-adding-failed = Échec de l'ajout de l'action.

cmd-addaction-player-completion = <EntityUid>
cmd-addaction-action-completion = <ActionProto>
