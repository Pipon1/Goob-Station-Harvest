### UI

paper-ui-blank-page-message = Cette page a été laissée blanche intentionnellement

# Shown when paper with words examined details
paper-component-examine-detail-has-words = {CAPITALIZE(THE($paper))} contient quelque chose d'écrit.
# Shown when paper with stamps examined
paper-component-examine-detail-stamped-by = {CAPITALIZE(THE($paper))} {CONJUGATE-HAVE($paper)} été tamponné par : {$stamps}.
paper-component-illiterate = Vous êtes incapable d'écrire.
paper-component-illiterate-mime = Ton vœu t'interdit d'écrire.

paper-component-action-stamp-paper-other = {CAPITALIZE(THE($user))} tamponne {THE($target)} avec {THE($stamp)}.
paper-component-action-stamp-paper-self = Vous tamponnez {THE($target)} avec {THE($stamp)}.

# Indicator to show how full a paper is
paper-ui-fill-level = {$currentLength}/{$maxLength}

paper-ui-save-button = Enregistrer ({$keybind})

paper-tamper-proof-modified-message = Cette page a été écrite avec de l'encre antifraude.
