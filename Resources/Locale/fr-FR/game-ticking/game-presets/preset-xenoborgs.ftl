xenoborgs-neutral = [color=white]Résultat neutre ![/color]
xenoborgs-crewminor = [color=yellow]Victoire mineure de l'équipage ![/color]
xenoborgs-crewmajor = [color=yellow]Victoire majeure de l'équipage ![/color]

xenoborgs-cond-all-xenoborgs-dead-core-alive = Tous les xénoborgs ont été détruits. Le cœur du vaisseau-mère dérive toujours dans l'espace.
xenoborgs-cond-all-xenoborgs-dead-core-dead = Le cœur du vaisseau-mère a été détruit et il n'y a plus de xénoborgs.

xenoborg-number-xenoborg-alive-end = Nombre de xénoborgs vivants : {$count}
