supermatter-halberd-execution-start-user = Vous portez {THE($used)} haut, prêt à l'abattre sur {$target} !
supermatter-halberd-execution-start-other = {CAPITALIZE($user)} porte {THE($used)} haut, prêt à l'abattre sur {$target} !
supermatter-halberd-execution-cancel = Vous baissez {THE($used)}. Il y aura du temps pour les anéantir plus tard...
supermatter-halberd-execution-end-user = Vous abattez {THE($used)}, anéantissant {$target} d'un coup puissant !
supermatter-halberd-execution-end-other = {CAPITALIZE($user)} abat {THE($used)}, anéantissant {$target} d'un coup puissant !